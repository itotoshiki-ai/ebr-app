# --- Google Cloud Vision API (証憑画像からの情報抽出。月1000ユニットまで無料) ---
# https://console.cloud.google.com/apis/credentials でAPIキーを発行して設定
GOOGLE_VISION_API_KEY=
# 自社名。証憑内に自社名(請求書の宛先など)が含まれていても、取引先として誤採用しないために使用
OWN_COMPANY_NAME=

# --- Azure AD App Registration (OneDriveアクセス用) ---
# Azure Portal > アプリの登録 で作成。詳細は README.md 参照。
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# 個人用Microsoftアカウントのみ: "consumers"
# 自社のMicrosoft 365テナントのみ(シングルテナント): "https://login.microsoftonline.com/<自社ドメイン or テナントID>"
#   例: https://login.microsoftonline.com/contoso.onmicrosoft.com
# 任意の組織アカウント: "organizations" / 個人・組織どちらも許可: "common"
AZURE_AUTHORITY_HOST=https://login.microsoftonline.com/consumers
# Azure Portalのアプリ登録でリダイレクトURIに登録したものと一致させる
# 常時稼働サーバーとして社内の他端末からアクセスする場合は、certs/配下に証明書を
# 生成した上で https://<サーバーのホスト名やIP>:3000/auth/callback に変更すること
# (詳細はREADME.mdの「常時稼働サーバーへのデプロイ」参照)
REDIRECT_URI=http://localhost:3000/auth/callback

# --- OneDrive保存先フォルダ (ルートからの相対パス) ---
ONEDRIVE_TARGET_FOLDER=電子帳簿保存

# --- サーバー設定 ---
PORT=3000
SESSION_SECRET=change-this-to-a-random-string
